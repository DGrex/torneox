# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env (con valores reales) al repositorio.

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente
DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# En desarrollo no se define DATABASE_URL (se usa SQLite por defecto).
# En producción, ejemplo para PostgreSQL:
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd

# Solo aplica cuando DEBUG=False:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tudominio.com
